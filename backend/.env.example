# Environment Setup
NODE_ENV=production
PORT=10000

# TiDB Cloud / MySQL Database Configuration
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=ecomargin_db
DB_USER=2xxxxxxxxx.root
DB_PASSWORD=your_tidb_password_here
DB_SSL=true

# JWT Authentication
JWT_SECRET=supersecretjwtkey_ecomargin_change_in_production
JWT_EXPIRATION=24h

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Production Vercel CORS & Client Application URLs
CLIENT_URL=https://eco-margin-frontend.vercel.app,https://eco-margin-admin-panel.vercel.app,https://ecomargin.vercel.app,https://ecomargin-admin.vercel.app
ALLOWED_ORIGINS=https://eco-margin-frontend.vercel.app,https://eco-margin-admin-panel.vercel.app,https://ecomargin.vercel.app,https://ecomargin-admin.vercel.app

# Nodemailer SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=info@ecomargin.in
EMAIL_PASS=your_smtp_app_password
EMAIL_FROM=sales@ecomargin.in
ADMIN_NOTIFY_EMAIL=sales@ecomargin.in
