# API Configuration
VITE_API_BASE_URL=https://eco-margin.onrender.com/api/v1
VITE_API_TIMEOUT=30000

# App Metadata
VITE_APP_NAME=EcoMargin
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=production

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
VITE_MAP_DEFAULT_LAT=20.5937
VITE_MAP_DEFAULT_LNG=78.9629
VITE_MAP_DEFAULT_ZOOM=5

# Firebase (Optional)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Payment Gateway
VITE_RAZORPAY_KEY_ID=
VITE_STRIPE_PUBLISHABLE_KEY=

# Analytics
VITE_GA_MEASUREMENT_ID=
VITE_HOTJAR_ID=

# Features
VITE_ENABLE_BOOKING=true
VITE_ENABLE_LIVE_MAP=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_PAYMENT=true